# DecisionTrace Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# MongoDB
MONGODB_URI=mongodb://localhost:27017/decisiontrace

# API Server
API_PORT=5000
API_HOST=localhost
NODE_ENV=development

# JWT Authentication
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=1h

# Checkpoint HMAC Signing
# This is a PROTOTYPE mechanism. See docs/security-and-privacy.md for limitations.
CHECKPOINT_HMAC_SECRET=CHANGE_ME_hmac_secret_min_32_chars_long

# Frontend
VITE_API_URL=http://localhost:5000/api/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
