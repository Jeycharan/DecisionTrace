{
  "name": "decisiontrace",
  "version": "1.0.0",
  "private": true,
  "description": "Decision traceability and audit platform for financial institutions",
  "scripts": {
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "test:api": "cd apps/api && npm test",
    "test:web": "cd apps/web && npm test",
    "lint:api": "cd apps/api && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "seed": "cd apps/api && npm run seed",
    "send-events": "cd apps/api && npx tsx ../../scripts/send-sample-events.ts"
  },
  "keywords": ["audit", "compliance", "fintech", "decision-trace"],
  "license": "MIT"
}
